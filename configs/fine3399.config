# Fine3399 wired router - OpenWrt 24.10 seed config
# Only the essentials are listed; `make defconfig` fills in the rest.

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
# 24.10 only exposes the per-device symbols when multi-profile is on
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_rumu3f_fine3399=y

# 32 MiB boot partition, 2 GiB rootfs (rest of the 8 GiB eMMC is free for a data partition)
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n

# Web UI + PPPoE + multi-WAN
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# PPPoE (luci-proto-ppp is the package that adds the PPPoE protocol page)
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# Routing helpers
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y

# Storage / NVMe
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkdiscard=y

# Networks / board peripherals
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-input-gpio-keys=y

# Convenience
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
